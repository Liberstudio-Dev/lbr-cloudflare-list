{
  "name": "@liberstudio/cloudflare-list",
  "version": "2.4.5",
  "description": "Modulo NestJS per gestione IP List Cloudflare",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Liberstudio-Dev/lbr-cloudflare-list.git"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx tsc",
    "prepublishOnly": "npm run build",
    "version:bump": "npx tsx src/scripts/version-bump.ts",
    "pub": "npm run build && npm publish --access public"
  },
  "publishConfig": {
    "access": "public"
  },
  "simple-git-hooks": {
    "pre-commit": "source ~/.bashrc && npm run version:bump && git add package.json package-lock.json"
  },
  "peerDependencies": {
    "@nestjs/axios": ">=3.0.0",
    "@nestjs/common": ">=10.4.3",
    "@nestjs/core": ">=10.4.3",
    "axios": ">=1.18.0",
    "rxjs": ">=7.0.0"
  },
  "devDependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "axios": "^1.18.0",
    "rxjs": "^7.8.2",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.0.0"
  },
  "allowScripts": {
    "simple-git-hooks@2.13.1": true
  }
}
