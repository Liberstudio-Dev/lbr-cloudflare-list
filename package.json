{
  "name": "@liberstudio/cloudflare-list",
  "version": "3.0.2",
  "description": "Modulo NestJS per gestione IP List Cloudflare",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Liberstudio-Dev/lbr-cloudflare-list.git"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "version:bump": "npx tsx src/scripts/version-bump.ts",
    "pub": "npm run build && npm publish --access public"
  },
  "publishConfig": {
    "access": "public"
  },
  "simple-git-hooks": {
    "pre-commit": "[ -f \"$HOME/.bashrc\" ] && \\. \"$HOME/.bashrc\"; export NVM_DIR=\"$HOME/.nvm\"; [ -s \"$NVM_DIR/nvm.sh\" ] && \\. \"$NVM_DIR/nvm.sh\"; npm run version:bump && git add package.json package-lock.json"
  },
  "peerDependencies": {
    "@nestjs/axios": "^3.0.0 || ^4.0.0 || ^12.0.0",
    "@nestjs/common": "^10.4.3 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.4.3 || ^11.0.0 || ^12.0.0",
    "axios": ">=1.18.0",
    "rxjs": ">=7.0.0"
  },
  "devDependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "axios": "^1.21.0",
    "rxjs": "^7.8.2",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.0.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "simple-git-hooks@2.13.1": true
  }
}
